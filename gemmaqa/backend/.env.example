# GemmaQA Backend Environment

APP_NAME=GemmaQA
DEBUG=true
# Bind localhost by default — API has no auth. Use 0.0.0.0 only on trusted networks.
HOST=127.0.0.1
PORT=8000

# SQLite database (async)
DATABASE_URL=sqlite+aiosqlite:///./gemmaqa.db

# Frontend origin for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Gemma provider: mock | openai_compatible | gemini | bedrock | transformers
# ---------------------------------------------------------------------------
# Default used when the UI has not picked one. The header/Settings dropdown
# overrides this at runtime (gemmaqa/.runtime-provider) without editing .env.
# mock               = deterministic heuristics (default / CI; no model)
# openai_compatible  = Ollama / LM Studio / vLLM / hosted OpenAI-compatible API
# gemini             = Google AI Studio (needs GEMINI_API_KEY)
# bedrock            = Amazon Bedrock (needs AWS_REGION + BEDROCK_MODEL_ID)
# transformers       = lazy local Hugging Face pipeline (optional deps)
# Legacy aliases: stub→mock, api/local/remote→openai_compatible
GEMMA_PROVIDER=mock

# Model id as exposed by your endpoint / hub (do NOT assume a fixed name)
GEMMA_MODEL_ID=

# OpenAI-compatible base URL, e.g. http://127.0.0.1:11434/v1  or https://host/v1
GEMMA_API_BASE_URL=
GEMMA_API_KEY=

# Optional Google Gemini (Model dropdown). pip install -r requirements-gemini.txt
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.5-flash

GEMMA_TIMEOUT_SECONDS=60
GEMMA_MAX_OUTPUT_TOKENS=512
GEMMA_TEMPERATURE=0

# Multimodal image_url parts (preferred). Legacy: GEMMA_SUPPORTS_VISION
GEMMA_SUPPORTS_IMAGES=false
GEMMA_SUPPORTS_VISION=false

# Used when GEMMA_PROVIDER=transformers (lazy-loaded on first generate call)
GEMMA_LOCAL_MODEL_PATH=
# Legacy helper when GEMMA_PROVIDER=local
GEMMA_LOCAL_BACKEND=openai_compatible

# Stop model-driven actions after N consecutive provider failures
GEMMA_MAX_CONSECUTIVE_FAILURES=3

# ---------------------------------------------------------------------------
# Local Ollama example (recommended for laptop development)
# ---------------------------------------------------------------------------
# 1) ollama pull gemma3:4b
# 2) Ensure Ollama is running (default http://127.0.0.1:11434)
# 3) Set:
# GEMMA_PROVIDER=openai_compatible
# GEMMA_API_BASE_URL=http://127.0.0.1:11434/v1
# GEMMA_MODEL_ID=gemma3:4b
# GEMMA_API_KEY=
# GEMMA_TEMPERATURE=0.1
# Misconfigured openai_compatible does NOT fall back to mock — fix env or set mock.

# ---------------------------------------------------------------------------
# Browser adapter: direct_playwright | playwright_mcp
# ---------------------------------------------------------------------------
# direct_playwright = in-process Playwright Chromium (default; full exploratory runs)
# playwright_mcp    = official Playwright MCP tool gateway (executor still required)
BROWSER_ADAPTER=direct_playwright
# Optional HTTP MCP endpoint (else stdio via npx):
# PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y,@playwright/mcp@latest
PLAYWRIGHT_MCP_TIMEOUT_SECONDS=60

# Browser defaults
PLAYWRIGHT_HEADLESS=true
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
NO_PROGRESS_LIMIT=5
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ENABLE_TRACING=true

# ---------------------------------------------------------------------------
# Safety / target policy
# ---------------------------------------------------------------------------
# Default is false (reject localhost/private/metadata). Enable ONLY for local demos.
ALLOW_LOCAL_TARGETS=true
# When DEBUG=false, credentials require HTTPS targets
REQUIRE_HTTPS_CREDENTIALS=true
ALLOW_SUBDOMAINS_DEFAULT=false
MAX_RETRIES=3
MAX_SCREENSHOTS=200
MAX_PROMPT_CHARS=24000
MAX_EVIDENCE_BYTES=209715200
STORE_FULL_HTML=false
# Optional extra blocked UI phrases (comma-separated)
BLOCKED_TEXT_PATTERNS_EXTRA=

# ---------------------------------------------------------------------------
# AWS Strands Agents (Agents for Humans) — off by default
# ---------------------------------------------------------------------------
# Official SDK: pip install -r requirements-strands.txt
# https://strandsagents.com/docs/user-guide/quickstart/python/
# Do not put real keys in git. Use AWS credentials or AWS_BEARER_TOKEN_BEDROCK
# in a local .env only.
USE_STRANDS_ORCHESTRATION=false
# AWS_REGION=us-east-1
# STRANDS_MODEL_ID=
# BEDROCK_MODEL_ID=
# Then POST /api/runs/strands or set USE_STRANDS_ORCHESTRATION=true so New Run
# is coordinated by Strands (AgentController + Playwright still execute).
