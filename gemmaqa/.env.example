# GemmaQA — root environment template (no real secrets)
# Copy to gemmaqa/.env and/or component .env files as needed.
# Ports: backend 8000 | frontend 5173

# --- Backend (backend/.env) ---
APP_NAME=GemmaQA
DEBUG=true
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./gemmaqa.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMMA_PROVIDER=mock
# Optional Gemini (Model dropdown): pip install -r backend/requirements-gemini.txt
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.5-flash
GEMMA_MODEL_ID=
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
GEMMA_TIMEOUT_SECONDS=60
GEMMA_MAX_OUTPUT_TOKENS=512
GEMMA_TEMPERATURE=0
GEMMA_SUPPORTS_IMAGES=false
GEMMA_SUPPORTS_VISION=false
GEMMA_LOCAL_BACKEND=openai_compatible
GEMMA_LOCAL_MODEL_PATH=
GEMMA_MAX_CONSECUTIVE_FAILURES=3

PLAYWRIGHT_HEADLESS=true
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
NO_PROGRESS_LIMIT=5
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
ENABLE_TRACING=true

# Safety — enable for local demo targets only
ALLOW_LOCAL_TARGETS=true
REQUIRE_HTTPS_CREDENTIALS=true
ALLOW_SUBDOMAINS_DEFAULT=false
# Authentication / controlled writes
ALLOW_LOGIN=true
ALLOW_TEST_ACCOUNT_CREATION=true
ALLOW_SAFE_TEST_DATA_CREATION=false
ALLOW_DESTRUCTIVE_ACTIONS=false
ALLOW_FINANCIAL_ACTIONS=false
MAX_RETRIES=3
MAX_SCREENSHOTS=200
MAX_PROMPT_CHARS=24000
MAX_EVIDENCE_BYTES=209715200
STORE_FULL_HTML=false
BLOCKED_TEXT_PATTERNS_EXTRA=

# --- Frontend (frontend/.env) ---
# Leave blank to use Vite proxy to the backend (recommended for local dev)
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEMO_MODE=false
